@namespace Phoenixx99JD_Zeuspet.Web.Components.Shared

<div class="equalizer-container">
    <div class="equalizer-heading">
        <span class="equalizer-label">@Etiqueta</span>
        <strong class="equalizer-value">@Valor</strong>
    </div>
    <div class="equalizer-bars" role="group" aria-label="@Etiqueta">
        @for (var i = 1; i <= 10; i++)
        {
            var valorBarra = i;
            <div class="equalizer-bar"
                 role="button"
                 tabindex="0"
                 aria-label="@Etiqueta: @valorBarra"
                 style="height: @(16 + (valorBarra * 4))px; background-color: @ColorDeBarra(valorBarra);"
                 @onclick="() => Seleccionar(valorBarra)"></div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Etiqueta { get; set; } = "";

    [Parameter]
    public int Valor { get; set; }

    [Parameter]
    public EventCallback<int> ValorChanged { get; set; }

    private async Task Seleccionar(int i)
    {
        Valor = i;
        await ValorChanged.InvokeAsync(i);
    }

    private string ColorDeBarra(int posicion)
    {
        if (posicion > Valor)
            return "var(--line)";

        var progreso = (posicion - 1) / 9d;
        return progreso <= .5
            ? InterpolarColor("#e8635f", "#f0b429", progreso * 2)
            : InterpolarColor("#f0b429", "#3fa66e", (progreso - .5) * 2);
    }

    private static string InterpolarColor(string inicio, string fin, double progreso)
    {
        var inicioRgb = HexAColor(inicio);
        var finRgb = HexAColor(fin);
        var rojo = (int)Math.Round(inicioRgb.R + ((finRgb.R - inicioRgb.R) * progreso));
        var verde = (int)Math.Round(inicioRgb.G + ((finRgb.G - inicioRgb.G) * progreso));
        var azul = (int)Math.Round(inicioRgb.B + ((finRgb.B - inicioRgb.B) * progreso));
        return $"#{rojo:X2}{verde:X2}{azul:X2}";
    }

    private static (int R, int G, int B) HexAColor(string color) =>
        (Convert.ToInt32(color[1..3], 16), Convert.ToInt32(color[3..5], 16), Convert.ToInt32(color[5..7], 16));
}
