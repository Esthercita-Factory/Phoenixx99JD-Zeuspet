@page "/agenda"
@rendermode InteractiveServer
@using Phoenixx99JD_Zeuspet.Web.Models
@using Phoenixx99JD_Zeuspet.Web.Services
@inject VeterinariaService Service

<div class="zeus-shell">
    <ZeusNavbar Active="Agenda" />

    <main class="agenda-page">
        <div class="pets-page-heading"><div><p class="eyebrow">Clinic calendar</p><h1>Agenda</h1><p class="welcome-copy">Todas las citas pendientes de tus pacientes.</p></div><a class="zeus-btn-primary" href="/">Volver al dashboard</a></div>
        <section class="soft-card agenda-panel"><div class="section-heading"><div><p class="eyebrow">Upcoming schedule</p><h2>Próximas citas</h2></div><span class="panel-contador">@Citas.Count pendientes</span></div>
            @if (Citas.Count == 0)
            {
                <div class="activities-empty"><i class="icon icon-calendar-off"></i><h2>Agenda al día</h2><p>No hay citas pendientes registradas.</p></div>
            }
            else
            {
                <div class="agenda-list">@foreach (var cita in Citas){<article class="schedule-item @CitaTheme(cita.Tipo)"><span class="schedule-icon"><i class="icon @CitaIcon(cita.Tipo)"></i></span><div><strong>@cita.Titulo</strong><span>@cita.Hora · @NombreMascota(cita.MascotaId)</span></div><span class="agenda-type">@cita.Tipo</span></article>}</div>
            }
        </section>
    </main>
</div>

@if (!string.IsNullOrWhiteSpace(ToastMessage))
{
    <div class="zeus-toast" role="status">@ToastMessage</div>
}

@code {
    private List<CitaAgenda> Citas { get; set; } = [];
    private List<Mascota> Mascotas { get; set; } = [];
    private string? ToastMessage { get; set; }

    protected override void OnInitialized()
    {
        Mascotas = Service.ListarMascotas();
        Citas = Service.ListarProximasCitas();
    }

    private string NombreMascota(string mascotaId) => Mascotas.FirstOrDefault(mascota => mascota.Id == mascotaId)?.Nombre ?? "Mascota";
    private string CitaIcon(string tipo) => tipo.ToLowerInvariant() switch { "veterinaria" => "icon-stethoscope", "aseo" => "icon-scissors", "social" => "icon-gamepad-2", _ => "icon-calendar" };
    private string CitaTheme(string tipo) => tipo.ToLowerInvariant() switch { "veterinaria" => "schedule-red", "aseo" => "schedule-orange", _ => "schedule-green" };
    private void MostrarProximamente() => ToastMessage = "Próximamente";
}
