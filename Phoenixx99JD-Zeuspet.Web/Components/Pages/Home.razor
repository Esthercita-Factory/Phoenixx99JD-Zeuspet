    private List<Recordatorio> ProximosRecordatorios =>
        clienteActualId is null ? [] : Service.ListarProximosRecordatoriosDeCliente(clienteActualId);

    private void AbrirModalRecordatorio()
    {
        if (Sesion.Rol != "Usuario") return;

        if (MascotasActuales.Count == 0)
        {
            MostrarToast("Primero agrega una mascota.");
            return;
        }

        NuevoRecordatorio = new RecordatorioForm { MascotaId = MascotaSeleccionadaId ?? MascotasActuales[0].Id };
        RecordatorioModalVisible = true;
    }

    private void CerrarModalRecordatorio() => RecordatorioModalVisible = false;

    private async Task GuardarRecordatorio()
    {
        if (Sesion.Rol != "Usuario") return;

        if (string.IsNullOrWhiteSpace(NuevoRecordatorio.Titulo) || string.IsNullOrWhiteSpace(NuevoRecordatorio.Hora))
        {
            MostrarToast("Completa los datos del recordatorio.");
            return;
        }

        Guardando = true;
        await InvokeAsync(StateHasChanged);

        Service.AgregarRecordatorio(NuevoRecordatorio.MascotaId, NuevoRecordatorio.Titulo.Trim(), NuevoRecordatorio.Fecha, NuevoRecordatorio.Hora.Trim());
        RecordatorioModalVisible = false;
        Guardando = false;
        MostrarToast("Recordatorio agregado correctamente.");
        await InvokeAsync(StateHasChanged);
    }

    private string NombreMascotaDe(string mascotaId) => Service.BuscarMascotaPorId(mascotaId)?.Nombre ?? "Mascota";
