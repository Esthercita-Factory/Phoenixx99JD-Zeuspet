@page "/dashboard"
@rendermode InteractiveServer
@using Phoenixx99JD_Zeuspet.Web.Models
@using Phoenixx99JD_Zeuspet.Web.Services
@using Microsoft.JSInterop
@inject VeterinariaService Service
@inject SesionService Sesion
@inject IJSRuntime JS

<div class="zeus-shell">
    <ZeusNavbar Active="Dashboard" />

    <RolRequerido Rol="Cualquiera">
    <main class="zeus-layout">
        <section class="zeus-main-column">
            <div class="welcome-row">
                <div><p class="eyebrow">Good morning, Alex</p><h1>Happy Pets,<br /><em>Happier You</em></h1><p class="welcome-copy">Let's get started! Keep every furry friend feeling their best.</p></div>
                <div class="pets-shortcut"><div><span class="section-label">Your pets</span><div class="pet-avatars">@foreach (var mascota in MascotasActuales){<button type="button" class="pet-avatar pet-real @(MascotaSeleccionadaId == mascota.Id ? "selected" : "")" title="@mascota.Nombre" aria-label="Seleccionar @mascota.Nombre" @onclick="() => SeleccionarMascota(mascota.Id)">@IconoEspecie(mascota.Especie)</button>}@if (Sesion.Rol == "Veterinario"){<a class="add-pet" href="/mascotas" aria-label="Agregar mascota"><i class="icon icon-plus"></i></a>}</div></div>@if (Sesion.Rol == "Veterinario"){<span class="add-label">Add new</span>}</div>
            </div>

            <section class="content-section activities-section">
                <div class="section-heading"><div><p class="eyebrow">Stay on track</p><h2>Activities</h2></div><div class="filter-tabs">@foreach (var filter in Filters){<button class="@(ActiveFilter == filter ? "selected" : "")" @onclick="() => ActiveFilter = filter">@filter</button>}</div></div>
                <div class="activity-grid">
                    @foreach (var activity in FilteredActivities)
                    {
                        <article class="activity-card @ActivityTheme(activity)"><span class="activity-icon"><i class="icon @ActivityIcon(activity)"></i></span><i class="icon icon-arrow-up-right activity-arrow"></i><div class="activity-info"><strong>@activity.Nombre</strong><span>@activity.Hora</span></div></article>
                    }
                    <button class="activity-card add-activity" @onclick="AddActivity"><span class="add-activity-icon"><i class="icon icon-plus"></i></span><strong>Add activity</strong></button>
                </div>
            </section>

            <div class="metrics-grid">
                <section class="soft-card weight-card"><div class="card-heading"><h3>Weight tracker</h3><button class="card-link" type="button" @onclick="MostrarProximamente">View all <i class="icon icon-arrow-up-right"></i></button></div>@if (UltimoPeso is null){<div class="quality-empty">Sin registros de peso aún</div>}else{<div class="weight-value"><strong>@UltimoPeso.Value.ToString("0.0") <small>kg</small></strong></div><div class="weight-chart" aria-label="Evolución del peso"><canvas id="weight-chart"></canvas></div>}</section>
                <section class="soft-card quality-card"><div class="card-heading"><h3>Quality of life</h3><button class="card-link" type="button" @onclick="MostrarProximamente">View all <i class="icon icon-arrow-up-right"></i></button></div><div class="quality-body">@if (UltimaEvaluacion is null){<div class="quality-empty">Sin evaluaciones aún<a href="/evaluaciones">Registrar evaluación</a></div>}else{<div class="quality-score evaluation-score">@UltimaEvaluacion.Promedio.ToString("0.0")<small>/10</small></div><div class="quality-chart-wrap"><canvas id="quality-chart"></canvas></div>}</div></section>
            </div>
        </section>

        <aside class="zeus-sidebar">
            <section class="featured-pet">@if (MascotaSeleccionada is not null){<img src="@FotoMascota(MascotaSeleccionada)" alt="@MascotaSeleccionada.Nombre" /><div class="pet-overlay"><div><span>Meet your pet</span><h2>@MascotaSeleccionada.Nombre</h2><p>@MascotaSeleccionada.Especie · @MascotaSeleccionada.Raza</p></div><span class="pet-alert">@ActividadesSeleccionadas.Count()</span></div>}else{<div class="featured-pet-empty">Selecciona una mascota</div>}</section>
            <section class="calendar-card soft-card"><div class="card-heading"><h3>@MonthTitle</h3><div><button aria-label="Mes anterior" @onclick="PreviousMonth"><i class="icon icon-chevron-left"></i></button><button aria-label="Mes siguiente" @onclick="NextMonth"><i class="icon icon-chevron-right"></i></button></div></div><div class="calendar-week">@foreach (var day in CalendarDays){<span>@day</span>}</div><div class="calendar-dates">@foreach (var date in CalendarDates){<span class="@CalendarDateClass(date)" @onclick="() => SeleccionarFecha(date.Date)">@date.Date.Day</span>}</div></section>
            <section class="schedule-card soft-card"><div class="card-heading"><div><p class="eyebrow">Don't miss out</p><h3>Upcoming schedule</h3></div><div class="schedule-menu-wrap"><button class="more-button" type="button" aria-label="Más opciones" @onclick="ToggleScheduleMenu"><i class="icon icon-ellipsis"></i></button>@if (ScheduleMenuVisible){<div class="schedule-menu">@if (Sesion.Rol == "Usuario"){<button type="button" @onclick="AbrirModalSolicitudCita"><i class="icon icon-calendar-plus"></i> Solicitar cita</button>}@if (Sesion.Rol == "Veterinario"){<button type="button" @onclick="AbrirModalNuevaCita"><i class="icon icon-calendar-plus"></i> Agregar cita</button>}<a href="/agenda" @onclick="CerrarMenus"><i class="icon icon-list"></i> Ver todas</a></div>}</div></div><div class="schedule-list">@foreach (var cita in ProximasCitas){<article class="schedule-item @CitaTheme(cita.Tipo)"><span class="schedule-icon"><i class="icon @CitaIcon(cita.Tipo)"></i></span><div><strong>@cita.Titulo</strong><span>@cita.Hora</span>@if (cita.Estado == "Pendiente"){<small class="schedule-pending-badge">Pendiente de confirmación</small>}</div>@if (Sesion.Rol == "Veterinario"){<div class="schedule-action-wrap"><button class="schedule-chevron-button" type="button" aria-label="Opciones de @cita.Titulo" @onclick="() => ToggleCitaMenu(cita.Id)"><i class="icon icon-chevron-right schedule-chevron"></i></button>@if (CitaMenuId == cita.Id){<div class="cita-context-menu"><button type="button" @onclick="() => MarcarCita(cita.Id)">Marcar como completada</button><button type="button" @onclick="() => SolicitarEliminarCita(cita.Id)">Eliminar</button></div>}</div>}</article>}</div></section>
            @if (Sesion.Rol == "Usuario")
            {
            <section class="schedule-card soft-card"><div class="card-heading"><div><p class="eyebrow">Solo para ti</p><h3>Recordatorios</h3></div><button class="more-button" type="button" aria-label="Agregar recordatorio" @onclick="AbrirModalRecordatorio"><i class="icon icon-plus"></i></button></div><div class="schedule-list">@if (ProximosRecordatorios.Count == 0){<div class="agenda-empty-small"><i class="icon icon-bell"></i><p>No tienes recordatorios pendientes.</p></div>}@foreach (var recordatorio in ProximosRecordatorios){<article class="schedule-item schedule-orange"><span class="schedule-icon"><i class="icon icon-pill"></i></span><div><strong>@recordatorio.Titulo</strong><span>@recordatorio.Fecha.ToString("dd MMM") · @recordatorio.Hora · @NombreMascotaDe(recordatorio.MascotaId)</span></div></article>}</div></section>
            }
        </aside>
    </main>
    </RolRequerido>
</div>

<ZeusModal IsOpen="@ActivityModalVisible" OnClose="CerrarActivityModal" AriaLabelledBy="new-activity-title">
    <HeaderContent>
        <div><p class="eyebrow">Stay on track</p><h2 id="new-activity-title">Add an activity</h2></div>
    </HeaderContent>
    <ChildContent>
            <form class="pet-form" @onsubmit="GuardarActividad" @onsubmit:preventDefault>
                <label>Pet<select class="zeus-input" @bind="NuevaActividad.MascotaId">@foreach (var pet in MascotasActuales){<option value="@pet.Id">@pet.Nombre</option>}</select></label>
                <label>Activity name<input class="zeus-input" @bind="NuevaActividad.Nombre" placeholder="Ej. Walking" required /></label>
                <label>Time<input class="zeus-input" @bind="NuevaActividad.Hora" placeholder="Ej. 6:00 PM" required /></label>
                <label>Date<input class="zeus-input" type="date" @bind="NuevaActividad.Fecha" /></label>
                <label>Group<select class="zeus-input" @bind="NuevaActividad.Grupo"><option value="Alone">Alone</option><option value="With other pets">With other pets</option></select></label>
                <div class="modal-actions"><button class="zeus-btn-ghost" type="button" @onclick="CerrarActivityModal">Cancel</button><button class="zeus-btn-primary" type="submit" disabled="@Guardando">@if (Guardando){<span class="zeus-spinner"></span>} Save activity</button></div>
            </form>
    </ChildContent>
</ZeusModal>

@if (Sesion.Rol == "Veterinario")
{
<ZeusModal IsOpen="@CitaModalVisible" OnClose="CerrarModalCita" AriaLabelledBy="new-appointment-title">
    <HeaderContent>
        <div><p class="eyebrow">Upcoming schedule</p><h2 id="new-appointment-title">Agregar cita</h2></div>
    </HeaderContent>
    <ChildContent>
            <form class="pet-form" @onsubmit="GuardarCita" @onsubmit:preventDefault>
                <label>Mascota<select class="zeus-input" @bind="NuevaCita.MascotaId">@foreach (var pet in TodasLasMascotas){<option value="@pet.Id">@pet.Nombre</option>}</select></label>
                <label>Título<input class="zeus-input" @bind="NuevaCita.Titulo" placeholder="Ej. Control veterinario" required /></label>
                <label>Fecha<input class="zeus-input" type="date" @bind="NuevaCita.Fecha" /></label>
                <label>Hora<input class="zeus-input" @bind="NuevaCita.Hora" placeholder="Ej. 10:00 AM" required /></label>
                <label>Tipo<select class="zeus-input" @bind="NuevaCita.Tipo"><option value="veterinaria">Veterinaria</option><option value="aseo">Aseo</option><option value="social">Social</option><option value="otro">Otro</option></select></label>
                <div class="modal-actions"><button class="zeus-btn-ghost" type="button" @onclick="CerrarModalCita">Cancelar</button><button class="zeus-btn-primary" type="submit" disabled="@Guardando">@if (Guardando){<span class="zeus-spinner"></span>} Guardar cita</button></div>
            </form>
    </ChildContent>
</ZeusModal>
}

@if (Sesion.Rol == "Usuario")
{
<ZeusModal IsOpen="@SolicitudCitaModalVisible" OnClose="CerrarModalSolicitudCita" AriaLabelledBy="request-appointment-title">
    <HeaderContent>
        <div><p class="eyebrow">Upcoming schedule</p><h2 id="request-appointment-title">Solicitar cita</h2></div>
    </HeaderContent>
    <ChildContent>
        <form class="pet-form" @onsubmit="GuardarSolicitudCita" @onsubmit:preventDefault>
            <label>Mascota<input class="zeus-input" value="@MascotaSeleccionada?.Nombre" disabled /></label>
            <label>Título<input class="zeus-input" @bind="NuevaSolicitudCita.Titulo" placeholder="Ej. Control veterinario" required /></label>
            <label>Fecha<input class="zeus-input" type="date" @bind="NuevaSolicitudCita.Fecha" /></label>
            <label>Hora<input class="zeus-input" @bind="NuevaSolicitudCita.Hora" placeholder="Ej. 10:00 AM" required /></label>
            <label>Tipo<select class="zeus-input" @bind="NuevaSolicitudCita.Tipo"><option value="veterinaria">Veterinaria</option><option value="aseo">Aseo</option><option value="social">Social</option><option value="otro">Otro</option></select></label>
            <div class="modal-actions"><button class="zeus-btn-ghost" type="button" @onclick="CerrarModalSolicitudCita">Cancelar</button><button class="zeus-btn-primary" type="submit" disabled="@Guardando">@if (Guardando){<span class="zeus-spinner"></span>} Solicitar cita</button></div>
        </form>
    </ChildContent>
</ZeusModal>
}

@if (Sesion.Rol == "Usuario")
{
<ZeusModal IsOpen="@RecordatorioModalVisible" OnClose="CerrarModalRecordatorio" AriaLabelledBy="new-reminder-title">
    <HeaderContent>
        <div><p class="eyebrow">Solo para ti</p><h2 id="new-reminder-title">Nuevo recordatorio</h2></div>
    </HeaderContent>
    <ChildContent>
        <form class="pet-form" @onsubmit="GuardarRecordatorio" @onsubmit:preventDefault>
            <label>Mascota<select class="zeus-input" @bind="NuevoRecordatorio.MascotaId">@foreach (var pet in MascotasActuales){<option value="@pet.Id">@pet.Nombre</option>}</select></label>
            <label>Título<input class="zeus-input" @bind="NuevoRecordatorio.Titulo" placeholder="Ej. Pastilla antipulgas" required /></label>
            <label>Fecha<input class="zeus-input" type="date" @bind="NuevoRecordatorio.Fecha" /></label>
            <label>Hora<input class="zeus-input" @bind="NuevoRecordatorio.Hora" placeholder="Ej. 8:00 AM" required /></label>
            <div class="modal-actions"><button class="zeus-btn-ghost" type="button" @onclick="CerrarModalRecordatorio">Cancelar</button><button class="zeus-btn-primary" type="submit" disabled="@Guardando">@if (Guardando){<span class="zeus-spinner"></span>} Guardar recordatorio</button></div>
        </form>
    </ChildContent>
</ZeusModal>
}

@if (Sesion.Rol == "Veterinario" && CitaEliminarId is not null)
{
    <div class="zeus-modal" role="dialog" aria-modal="true">
        <div class="zeus-modal-content" style="max-width:380px">
            <div class="modal-title-row"><div><p class="eyebrow">Confirmar</p><h2 style="font-size:1.1rem">¿Eliminar esta cita?</h2></div><button class="modal-close" type="button" @onclick="CancelarEliminarCita" aria-label="Cerrar">×</button></div>
            <p style="margin:0 0 18px;color:var(--muted);font-size:.75rem">Esta acción no se puede deshacer.</p>
            <div class="modal-actions"><button class="zeus-btn-ghost" type="button" @onclick="CancelarEliminarCita">Cancelar</button><button class="zeus-btn-primary" style="background:#c55d5d;border-color:#c55d5d" @onclick="EliminarCitaConfirmada"><i class="icon icon-trash-2"></i> Sí, eliminar</button></div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(ToastMessage))
{
    <div class="zeus-toast" role="status">@ToastMessage</div>
}

@code {
    private string ActiveFilter { get; set; } = "All";
    private string? clienteActualId;
    private string? MascotaSeleccionadaId;
    private List<Mascota> MascotasActuales { get; set; } = [];
    private List<Mascota> TodasLasMascotas { get; set; } = [];
    private List<CitaAgenda> ProximasCitas { get; set; } = [];
    private NuevaActividadForm NuevaActividad { get; set; } = new();
    private NuevaCitaForm NuevaCita { get; set; } = new();
    private NuevaSolicitudCitaForm NuevaSolicitudCita { get; set; } = new();
    private RecordatorioForm NuevoRecordatorio { get; set; } = new();
    private bool ActivityModalVisible { get; set; }
    private bool CitaModalVisible { get; set; }
    private bool SolicitudCitaModalVisible { get; set; }
    private bool RecordatorioModalVisible { get; set; }
    private bool ScheduleMenuVisible { get; set; }
    private bool Guardando { get; set; }
    private string? CitaMenuId { get; set; }
    private string? CitaEliminarId { get; set; }
    private string? ToastMessage { get; set; }
    private CancellationTokenSource? ToastCts;
    private DateTime FechaSeleccionada = DateTime.Today;
    private bool GraficosPendientes;
    private readonly string[] Filters = ["All", "Alone", "With other pets"];
    private readonly string[] CalendarDays = ["M", "T", "W", "T", "F", "S", "S"];
    private DateTime CurrentMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string MonthTitle => CurrentMonth.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
    private IReadOnlyList<CalendarCell> CalendarDates => BuildCalendarDates();

    private Mascota? MascotaSeleccionada => MascotasActuales.FirstOrDefault(mascota => mascota.Id == MascotaSeleccionadaId);
    private IEnumerable<Actividad> ActividadesSeleccionadas => MascotaSeleccionadaId is null ? [] : Service.ListarActividadesDeMascota(MascotaSeleccionadaId);
    private IEnumerable<Actividad> FilteredActivities => MascotaSeleccionadaId is null ? [] : ActividadesSeleccionadas.Where(a => a.Fecha.Date == FechaSeleccionada.Date && (ActiveFilter == "All" || a.Grupo == ActiveFilter));
    private IReadOnlyList<RegistroPeso> RegistrosPeso => MascotaSeleccionadaId is null ? [] : Service.ListarRegistroPesoDeMascota(MascotaSeleccionadaId);
    private double? UltimoPeso => RegistrosPeso.LastOrDefault()?.Peso;
    private EvaluacionCalidadVida? UltimaEvaluacion => MascotaSeleccionadaId is null ? null : Service.ObtenerUltimaEvaluacion(MascotaSeleccionadaId);

    private IReadOnlyList<CalendarCell> BuildCalendarDates()
    {
        var firstDay = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
        var mondayOffset = ((int)firstDay.DayOfWeek + 6) % 7;
        var calendarStart = firstDay.AddDays(-mondayOffset);

        return Enumerable.Range(0, 42)
            .Select(index => new CalendarCell(calendarStart.AddDays(index), calendarStart.AddDays(index).Month == CurrentMonth.Month))
            .ToList();
    }

    private void PreviousMonth() => CurrentMonth = CurrentMonth.AddMonths(-1);
    private void NextMonth() => CurrentMonth = CurrentMonth.AddMonths(1);
    private void SeleccionarFecha(DateTime fecha) => FechaSeleccionada = fecha.Date;
    private string CalendarDateClass(CalendarCell cell)
    {
        if (!cell.IsCurrentMonth) return "";

        var clases = new List<string>();
        if (cell.Date.Date == DateTime.Today) clases.Add("today");
        if (cell.Date.Date == FechaSeleccionada.Date) clases.Add("selected");
        if (TieneActividadFecha(cell.Date)) clases.Add("marked");
        return string.Join(" ", clases);
    }

    private bool TieneActividadFecha(DateTime fecha)
    {
        var mascotaId = MascotaSeleccionadaId;

        var hayActividades = mascotaId is null
            ? Service.ListarTodasLasActividades()
            : Service.ListarActividadesDeMascota(mascotaId);

        if (hayActividades.Any(actividad => actividad.Fecha.Date == fecha.Date))
            return true;

        var citas = Service.ListarProximasCitas();
        return citas.Any(cita =>
            cita.Fecha.Date == fecha.Date &&
            cita.Estado != "Rechazada" &&
            (mascotaId is null || cita.MascotaId == mascotaId));
    }

    protected override void OnInitialized()
    {
        clienteActualId = string.IsNullOrWhiteSpace(Sesion.ClienteId)
            ? Service.ListarClientes().FirstOrDefault()?.Id
            : Sesion.ClienteId;
        CargarMascotasActuales();
        CargarCitas();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || GraficosPendientes)
        {
            GraficosPendientes = false;
            await ActualizarGraficos();
        }
    }

    private void CargarMascotasActuales()
    {
        MascotasActuales = clienteActualId is null ? [] : Service.ListarMascotasDeCliente(clienteActualId);
        TodasLasMascotas = Service.ListarMascotas();
        if (MascotasActuales.All(pet => pet.Id != MascotaSeleccionadaId))
            MascotaSeleccionadaId = MascotasActuales.FirstOrDefault()?.Id;
    }

    private async Task SeleccionarMascota(string mascotaId)
    {
        MascotaSeleccionadaId = mascotaId;
        FechaSeleccionada = DateTime.Today;
        GraficosPendientes = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ActualizarGraficos()
    {
        var labels = RegistrosPeso.Select(registro => registro.Fecha.ToString("MMM dd")).ToArray();
        var valores = RegistrosPeso.Select(registro => registro.Peso).ToArray();
        await JS.InvokeVoidAsync("renderWeightChart", "weight-chart", labels, valores);

        var evaluacion = UltimaEvaluacion;
        var evaluationLabels = new[] { "Behavior", "Hygiene", "Movement", "Mood" };
        var evaluationValues = evaluacion is null
            ? Array.Empty<int>()
            : new[] { evaluacion.Comportamiento, evaluacion.Higiene, evaluacion.Movimiento, evaluacion.Animo };
        await JS.InvokeVoidAsync("renderRadarChart", "quality-chart", evaluationLabels, evaluationValues);
    }

    private void CargarCitas()
    {
        var citas = Service.ListarProximasCitas();
        ProximasCitas = Sesion.Rol == "Usuario"
            ? citas.Where(cita => MascotasActuales.Any(mascota => mascota.Id == cita.MascotaId)).ToList()
            : citas.Where(cita => cita.Estado == "Confirmada").ToList();
    }

    private string IconoEspecie(string especie) => especie.ToLowerInvariant() switch
    {
        "perro" => "\ud83d\udc36",
        "gato" => "\ud83d\udc31",
        "conejo" => "\ud83d\udc30",
        _ => "\ud83d\udc3e"
    };

    private string FotoMascota(Mascota mascota) => !string.IsNullOrWhiteSpace(mascota.FotoUrl) ? mascota.FotoUrl : mascota.Especie.ToLowerInvariant() switch
    {
        "gato" => "https://images.unsplash.com/photo-1518791841217-8f162f1e1131?auto=format&fit=crop&w=900&q=85",
        "conejo" => "https://images.unsplash.com/photo-1585110396000-c9ffd4e4b308?auto=format&fit=crop&w=900&q=85",
        _ => "https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=900&q=85"
    };

    private void MostrarToast(string mensaje)
    {
        ToastCts?.Cancel();
        ToastMessage = mensaje;
        ToastCts = new CancellationTokenSource();
        _ = Task.Delay(3000, ToastCts.Token).ContinueWith(_ =>
        {
            ToastMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private void MostrarProximamente() => MostrarToast("Próximamente");
    private void ToggleScheduleMenu()
    {
        ScheduleMenuVisible = !ScheduleMenuVisible;
        CitaMenuId = null;
    }

    private void CerrarMenus() => ScheduleMenuVisible = false;

    private void AbrirModalNuevaCita()
    {
        if (Sesion.Rol != "Veterinario") return;

        ScheduleMenuVisible = false;
        NuevaCita = new NuevaCitaForm { MascotaId = TodasLasMascotas.FirstOrDefault()?.Id ?? "" };
        CitaModalVisible = true;
    }

    private void CerrarModalCita() => CitaModalVisible = false;

    private void AbrirModalSolicitudCita()
    {
        if (Sesion.Rol != "Usuario") return;

        ScheduleMenuVisible = false;
        if (MascotaSeleccionada is null)
        {
            MostrarToast("Selecciona una mascota para solicitar una cita.");
            return;
        }

        NuevaSolicitudCita = new NuevaSolicitudCitaForm();
        SolicitudCitaModalVisible = true;
    }

    private void CerrarModalSolicitudCita() => SolicitudCitaModalVisible = false;

    private void ToggleCitaMenu(string citaId)
    {
        if (Sesion.Rol != "Veterinario") return;

        CitaMenuId = CitaMenuId == citaId ? null : citaId;
        ScheduleMenuVisible = false;
    }

    private void MarcarCita(string citaId)
    {
        if (Sesion.Rol != "Veterinario") return;

        Service.MarcarCitaCompletada(citaId);
        CitaMenuId = null;
        CargarCitas();
        StateHasChanged();
    }

    private void SolicitarEliminarCita(string citaId)
    {
        if (Sesion.Rol != "Veterinario") return;

        CitaMenuId = null;
        CitaEliminarId = citaId;
    }

    private void CancelarEliminarCita() => CitaEliminarId = null;

    private async Task EliminarCitaConfirmada()
    {
        if (Sesion.Rol != "Veterinario" || CitaEliminarId is null) return;

        Service.EliminarCita(CitaEliminarId);
        CitaEliminarId = null;
        CargarCitas();
        MostrarToast("Cita eliminada correctamente.");
        await InvokeAsync(StateHasChanged);
    }

    private async Task GuardarCita()
    {
        if (Sesion.Rol != "Veterinario") return;

        if (string.IsNullOrWhiteSpace(NuevaCita.MascotaId) || string.IsNullOrWhiteSpace(NuevaCita.Titulo) || string.IsNullOrWhiteSpace(NuevaCita.Hora))
        {
            MostrarToast("Completa los datos de la cita.");
            return;
        }

        Guardando = true;
        await InvokeAsync(StateHasChanged);

        Service.AgregarCita(NuevaCita.MascotaId, NuevaCita.Titulo.Trim(), NuevaCita.Hora.Trim(), NuevaCita.Tipo, "Confirmada", NuevaCita.Fecha);
        CargarCitas();
        CitaModalVisible = false;
        Guardando = false;
        MostrarToast("Cita agregada correctamente.");
        await InvokeAsync(StateHasChanged);
    }

    private async Task GuardarSolicitudCita()
    {
        if (Sesion.Rol != "Usuario" || MascotaSeleccionada is null) return;

        if (string.IsNullOrWhiteSpace(NuevaSolicitudCita.Titulo) || string.IsNullOrWhiteSpace(NuevaSolicitudCita.Hora))
        {
            MostrarToast("Completa los datos de la cita.");
            return;
        }

        Guardando = true;
        await InvokeAsync(StateHasChanged);

        Service.SolicitarCita(MascotaSeleccionada.Id, NuevaSolicitudCita.Titulo.Trim(), NuevaSolicitudCita.Hora.Trim(), NuevaSolicitudCita.Tipo, NuevaSolicitudCita.Fecha);
        CargarCitas();
        SolicitudCitaModalVisible = false;
        Guardando = false;
        MostrarToast("Solicitud enviada correctamente.");
        await InvokeAsync(StateHasChanged);
    }

    private string CitaIcon(string tipo) => tipo.ToLowerInvariant() switch
    {
        "veterinaria" => "icon-stethoscope",
        "aseo" => "icon-scissors",
        "social" => "icon-gamepad-2",
        _ => "icon-calendar"
    };

    private string CitaTheme(string tipo) => tipo.ToLowerInvariant() switch
    {
        "veterinaria" => "schedule-red",
        "aseo" => "schedule-orange",
        _ => "schedule-green"
    };

    private void AddActivity()
    {
        if (MascotasActuales.Count == 0)
        {
            MostrarToast("Primero agrega una mascota.");
            return;
        }

        NuevaActividad = new NuevaActividadForm { MascotaId = MascotaSeleccionadaId ?? MascotasActuales[0].Id };
        ActivityModalVisible = true;
    }

    private void CerrarActivityModal() => ActivityModalVisible = false;

    private async Task GuardarActividad()
    {
        if (string.IsNullOrWhiteSpace(NuevaActividad.MascotaId) || string.IsNullOrWhiteSpace(NuevaActividad.Nombre) || string.IsNullOrWhiteSpace(NuevaActividad.Hora))
        {
            MostrarToast("Completa los datos de la actividad.");
            return;
        }

        Guardando = true;
        await InvokeAsync(StateHasChanged);

        MascotaSeleccionadaId = NuevaActividad.MascotaId;
        Service.AgregarActividad(MascotaSeleccionadaId, NuevaActividad.Nombre.Trim(), NuevaActividad.Hora.Trim(), NuevaActividad.Grupo, NuevaActividad.Fecha);
        GraficosPendientes = true;
        ActivityModalVisible = false;
        Guardando = false;
        MostrarToast("Actividad agregada correctamente.");
        await InvokeAsync(StateHasChanged);
    }

    private string ActivityIcon(Actividad activity) => activity.Nombre.ToLowerInvariant() switch
    {
        "walking" => "icon-footprints",
        "training" => "icon-sparkles",
        "playdate" => "icon-heart",
        _ => "icon-star"
    };

    private string ActivityTheme(Actividad activity) => activity.Nombre.ToLowerInvariant() switch
    {
        "walking" => "activity-green",
        "training" => "activity-orange",
        "playdate" => "activity-lilac",
        _ => "activity-green"
    };

