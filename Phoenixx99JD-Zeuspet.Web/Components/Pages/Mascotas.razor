@page "/mascotas"
@rendermode InteractiveServer
@using Phoenixx99JD_Zeuspet.Web.Models
@using Phoenixx99JD_Zeuspet.Web.Services
@using Microsoft.JSInterop
@inject VeterinariaService Service
@inject SesionService Sesion
@inject IJSRuntime JS

@if (CargandoPagina)
{
    <div class="zeus-loading-bar"></div>
}

<div class="zeus-shell">
    <ZeusNavbar Active="Pets" />

    <RolRequerido Rol="Veterinario">
    <main class="pets-page">
        <div class="pets-page-heading">
            <div><p class="eyebrow">Your companions</p><h1>All pets</h1><p class="welcome-copy">Keep every patient close and their care on track.</p></div>
            <div style="display:flex;align-items:center;gap:12px">
                <div class="search-wrap">
                    <i class="icon icon-search"></i>
                    <input class="search-input" placeholder="Buscar mascota..." @bind="BusquedaMascotas" @bind:after="FiltrarMascotas" />
                </div>
                @if (Sesion.Rol == "Veterinario")
                {
                    <button class="zeus-btn-primary" @onclick="AbrirModalNuevaMascota"><i class="icon icon-plus"></i> Nueva mascota</button>
                }
            </div>
        </div>

        @if (MascotaSeleccionadaId is null)
        {
            @if (CargandoPagina)
            {
                <div class="pets-grid">
                    @for (var i = 0; i < 6; i++)
                    {
                        <div class="activity-card" style="background:var(--canvas);opacity:.6;animation:zeus-pulse 1.4s ease-in-out infinite"><div style="height:14px;width:60%;background:var(--line);border-radius:8px"></div><div style="height:10px;width:40%;background:var(--line);border-radius:8px;margin-top:10px"></div><div style="height:10px;width:50%;background:var(--line);border-radius:8px;margin-top:8px"></div></div>
                    }
                </div>
            }
            else if (MascotasFiltradas.Count == 0 && string.IsNullOrWhiteSpace(BusquedaMascotas))
            {
                <section class="soft-card pets-empty"><i class="icon icon-paw-print"></i><h2>No hay mascotas registradas</h2><p>Agrega la primera mascota para comenzar.</p>@if (Sesion.Rol == "Veterinario"){<button class="zeus-btn-primary" @onclick="AbrirModalNuevaMascota">+ Nueva mascota</button>}</section>
            }
            else if (MascotasFiltradas.Count == 0 && !string.IsNullOrWhiteSpace(BusquedaMascotas))
            {
                <section class="soft-card pets-empty"><i class="icon icon-search"></i><h2>Sin resultados</h2><p>No se encontraron mascotas para "@BusquedaMascotas".</p></section>
            }
            else
            {
                <div class="pets-grid">
                    @foreach (var mascota in MascotasFiltradas)
                    {
                        <button class="activity-card pet-card @TemaEspecie(mascota.Especie)" @onclick="() => SeleccionarMascota(mascota.Id)" @key="mascota.Id">
                            <img class="pet-card-photo" src="@FotoPorRaza(mascota)" alt="Foto de @mascota.Nombre" loading="lazy" onerror="this.onerror=null;this.src='@FotoFallback(mascota)'" />
                            <span class="pet-card-score">@(Service.ObtenerUltimaEvaluacion(mascota.Id)?.Promedio.ToString("0.0") ?? "—")</span>
                            <i class="icon icon-arrow-up-right activity-arrow"></i>
                            <canvas id="mini-chart-@mascota.Id" class="pet-card-chart"></canvas>
                            @if (Service.ObtenerUltimaEvaluacion(mascota.Id) is null)
                            {
                                <small class="pet-card-no-evaluation">Sin evaluación</small>
                            }
                            <div class="pet-card-info"><strong>@mascota.Nombre</strong><span>@mascota.Especie · @mascota.Raza</span><small>@mascota.Edad años · @NombreDueno(mascota)</small></div>
                        </button>
                    }
                </div>
            }
        }
        else
        {
            @if (CargandoDetalle)
            {
                <a class="back-link" href="/mascotas" @onclick="CerrarDetalle">← Volver al catálogo</a>
                <section class="pet-file soft-card">
                    <div class="pet-file-banner" style="background:var(--canvas);min-height:180px;animation:zeus-pulse 1.4s ease-in-out infinite"></div>
                    <div style="padding:24px"><div style="height:14px;width:40%;background:var(--line);border-radius:8px"></div><div style="height:22px;width:25%;background:var(--line);border-radius:8px;margin-top:10px"></div><div style="height:10px;width:35%;background:var(--line);border-radius:8px;margin-top:8px"></div></div>
                </section>
            }
            else if (MascotaSeleccionada is not null)
            {
                <a class="back-link" href="/mascotas" @onclick="CerrarDetalle">← Volver al catálogo</a>
                <section class="pet-file soft-card">
                    <div class="pet-file-banner"><img src="@FotoPorRaza(MascotaSeleccionada)" alt="Foto de @MascotaSeleccionada.Nombre" onerror="this.onerror=null;this.src='@FotoFallback(MascotaSeleccionada)'" /></div>
                    <div class="pet-file-header"><div><p class="eyebrow">Patient profile</p><h1>@MascotaSeleccionada.Nombre</h1><p>@MascotaSeleccionada.Especie · @MascotaSeleccionada.Raza · @MascotaSeleccionada.Sexo</p></div><span class="status-badge">@MascotaSeleccionada.Estado</span></div>
                    @if (Sesion.Rol == "Veterinario")
                    {
                        <div class="pet-file-actions">
                            <button class="zeus-btn-primary" disabled="@Guardando" @onclick="AbrirModalNuevaConsulta"><i class="icon icon-file-plus"></i> Nueva consulta</button>
                            <button class="zeus-btn-ghost" disabled="@Guardando" @onclick="AbrirModalEditar"><i class="icon icon-pencil"></i> Editar</button>
                            <button class="zeus-btn-danger" disabled="@Guardando" @onclick="SolicitarEliminar"><i class="icon icon-trash-2"></i> Eliminar</button>
                        </div>
                    }
                    @if (Guardando)
                    {
                        <div class="delete-confirm"><span class="zeus-spinner zeus-spinner-dark"></span> Guardando...</div>
                    }
                    @if (Sesion.Rol == "Veterinario" && ConfirmarEliminacion)
                    {
                        <div class="delete-confirm"><span>¿Eliminar esta mascota y su historial?</span><button class="zeus-btn-danger" disabled="@Guardando" @onclick="EliminarMascotaConfirmada">Sí, eliminar</button><button class="zeus-btn-ghost" @onclick="CancelarEliminar">Cancelar</button></div>
                    }
                    <div class="info-grid pet-file-info-grid"><div class="info-card"><i class="icon icon-activity"></i><label>Estado</label><span class="status-badge">@MascotaSeleccionada.Estado</span></div><div class="info-card"><i class="icon icon-cake"></i><label>Edad</label><strong>@MascotaSeleccionada.Edad años</strong></div><div class="info-card"><i class="icon icon-weight"></i><label>Peso</label><strong>@(MascotaSeleccionada.Peso.HasValue ? $"{MascotaSeleccionada.Peso:0.0} kg" : "Sin registrar")</strong></div><div class="info-card"><i class="icon icon-user-round"></i><label>Dueño</label><strong>@DuenoSeleccionado?.Nombre</strong></div><div class="info-card"><i class="icon icon-phone"></i><label>Teléfono</label><strong>@(DuenoSeleccionado?.Telefono ?? "Sin registrar")</strong></div><div class="info-card"><i class="icon icon-notebook-pen"></i><label>Notas</label><p>@(string.IsNullOrWhiteSpace(MascotaSeleccionada.Notas) ? "Sin notas registradas." : MascotaSeleccionada.Notas)</p></div></div>
                    <div class="pet-file-section"><div class="card-heading"><div><p class="eyebrow">Medical history</p><h2>Historial de consultas (@ConsultasSeleccionadas.Count)</h2></div></div>@if (ConsultasSeleccionadas.Count == 0){<div class="consultas-empty"><i class="icon icon-stethoscope"></i><p>Aún no hay consultas registradas.</p>@if (Sesion.Rol == "Veterinario"){<button class="zeus-btn-primary" @onclick="AbrirModalNuevaConsulta">Registrar la primera</button>}</div>}else{<div class="consultas-list">@foreach (var consulta in ConsultasSeleccionadas){<article class="soft-card consulta-card"><div><p class="eyebrow">@consulta.Fecha.ToString("dd/MM/yyyy HH:mm")</p><strong>@consulta.Motivo</strong><p>@consulta.Notas</p></div><i class="icon icon-clipboard-list"></i></article>}</div>}</div>
                </section>
            }
            else
            {
                <section class="pet-detail pet-detail-empty soft-card"><i class="icon icon-mouse-pointer-click"></i><p>Selecciona una mascota para ver sus detalles</p></section>
            }
        }
    </main>
    </RolRequerido>
</div>

@if (Sesion.Rol == "Veterinario")
{
<ZeusModal IsOpen="@ModalVisible" OnClose="CerrarModal" AriaLabelledBy="new-pet-page-title">
    <HeaderContent>
        <div><p class="eyebrow">Patient profile</p><h2 id="new-pet-page-title">Nueva mascota</h2></div>
    </HeaderContent>
    <ChildContent>
            <form class="pet-form" @onsubmit="GuardarMascota" @onsubmit:preventDefault>
                <fieldset class="form-section"><legend>Dueño</legend><div class="owner-mode"><label><input type="radio" name="owner-mode-page" checked="@(!NuevaMascota.UsarNuevoCliente)" @onchange="() => NuevaMascota.UsarNuevoCliente = false" /> Cliente existente</label><label><input type="radio" name="owner-mode-page" checked="@NuevaMascota.UsarNuevoCliente" @onchange="() => NuevaMascota.UsarNuevoCliente = true" /> Nuevo cliente</label></div>
                    @if (!NuevaMascota.UsarNuevoCliente)
                    {
                        <label>Cliente<select class="zeus-input" @bind="NuevaMascota.ClienteId"><option value="">Selecciona un cliente</option>@foreach (var client in Clientes){<option value="@client.Id">@client.Nombre</option>}</select></label>
                    }
                    else
                    {
                        <div class="form-grid"><label>Nombre<input class="zeus-input" @bind="NuevaMascota.NombreCliente" /></label><label>Edad<input class="zeus-input" type="number" min="0" @bind="NuevaMascota.EdadCliente" /></label><label>Teléfono<input class="zeus-input" @bind="NuevaMascota.TelefonoCliente" /></label><label>Email<input class="zeus-input" type="email" @bind="NuevaMascota.EmailCliente" /></label><label class="form-grid-wide">Dirección<input class="zeus-input" @bind="NuevaMascota.DireccionCliente" /></label></div>
                    }
                </fieldset>
                <fieldset class="form-section"><legend>Mascota</legend><label>Nombre<input class="zeus-input" @bind="NuevaMascota.Nombre" required /></label><label>Especie<select class="zeus-input" @bind="NuevaMascota.Especie"><option value="Perro">Perro</option><option value="Gato">Gato</option><option value="Conejo">Conejo</option><option value="Otro">Otro</option></select></label><label>Raza<input class="zeus-input" @bind="NuevaMascota.Raza" /></label><label>Edad<input class="zeus-input" type="number" min="0" @bind="NuevaMascota.Edad" required /></label></fieldset>
                <div class="modal-actions"><button class="zeus-btn-ghost" type="button" @onclick="CerrarModal">Cancelar</button><button class="zeus-btn-primary" type="submit" disabled="@Guardando">@if (Guardando){<span class="zeus-spinner"></span>} Guardar mascota</button></div>
            </form>
    </ChildContent>
</ZeusModal>
}

@if (Sesion.Rol == "Veterinario")
{
<ZeusModal IsOpen="@ConsultaModalVisible" OnClose="CerrarModalConsulta" AriaLabelledBy="new-consulta-title">
    <HeaderContent>
        <div><p class="eyebrow">Medical history</p><h2 id="new-consulta-title">Nueva consulta</h2></div>
    </HeaderContent>
    <ChildContent>
        <form class="pet-form" @onsubmit="GuardarConsulta" @onsubmit:preventDefault><label>Motivo<input class="zeus-input" @bind="NuevaConsulta.Motivo" placeholder="Ej. Revisión general" required /></label><label>Notas<textarea class="zeus-input" @bind="NuevaConsulta.Notas" rows="4" placeholder="Observaciones de la consulta"></textarea></label><div class="modal-actions"><button class="zeus-btn-ghost" type="button" @onclick="CerrarModalConsulta">Cancelar</button><button class="zeus-btn-primary" type="submit" disabled="@Guardando">@if (Guardando){<span class="zeus-spinner"></span>} Guardar consulta</button></div></form>
    </ChildContent>
</ZeusModal>
}

@if (Sesion.Rol == "Veterinario")
{
<ZeusModal IsOpen="@EditarModalVisible" OnClose="CerrarModalEditar" AriaLabelledBy="edit-pet-title">
    <HeaderContent>
        <div><p class="eyebrow">Patient profile</p><h2 id="edit-pet-title">Editar datos</h2></div>
    </HeaderContent>
    <ChildContent>
        <form class="pet-form" @onsubmit="GuardarEdicion" @onsubmit:preventDefault><label>Peso (kg)<input class="zeus-input" type="number" step="0.1" min="0" @bind="EdicionMascota.Peso" /></label><label>Sexo<select class="zeus-input" @bind="EdicionMascota.Sexo"><option>Macho</option><option>Hembra</option></select></label><label>Estado<select class="zeus-input" @bind="EdicionMascota.Estado"><option>Activo</option><option>En tratamiento</option><option>Inactivo</option></select></label><label>Foto URL<input class="zeus-input" @bind="EdicionMascota.FotoUrl" /></label><label>Notas<textarea class="zeus-input" @bind="EdicionMascota.Notas" rows="4"></textarea></label><div class="modal-actions"><button class="zeus-btn-ghost" type="button" @onclick="CerrarModalEditar">Cancelar</button><button class="zeus-btn-primary" type="submit" disabled="@Guardando">@if (Guardando){<span class="zeus-spinner"></span>} Guardar cambios</button></div></form>
    </ChildContent>
</ZeusModal>
}

@if (!string.IsNullOrWhiteSpace(ToastMessage))
{
    <div class="zeus-toast" role="status">@ToastMessage</div>
}

@code {
    private List<Mascota> MascotasRegistradas { get; set; } = [];
    private List<Cliente> Clientes { get; set; } = [];
    private string? MascotaSeleccionadaId = null;
    private string BusquedaMascotas { get; set; } = "";
    private bool CargandoPagina { get; set; } = true;
    private bool CargandoDetalle { get; set; }
    private bool Guardando { get; set; }
    private CancellationTokenSource? ToastCts;

    private Mascota? MascotaSeleccionada => MascotasRegistradas.FirstOrDefault(mascota => mascota.Id == MascotaSeleccionadaId);
    private Cliente? DuenoSeleccionado => MascotaSeleccionada is null ? null : Service.BuscarClientePorId(MascotaSeleccionada.ClienteId);
    private List<Actividad> ActividadesSeleccionadas => MascotaSeleccionada is null ? [] : Service.ListarActividadesDeMascota(MascotaSeleccionada.Id);
    private List<Consulta> ConsultasSeleccionadas => MascotaSeleccionada is null ? [] : Service.ListarConsultasDeMascota(MascotaSeleccionada.Id);
    private EvaluacionCalidadVida? UltimaEvaluacionSeleccionada => MascotaSeleccionada is null ? null : Service.ObtenerUltimaEvaluacion(MascotaSeleccionada.Id);
    private List<Mascota> MascotasFiltradas => string.IsNullOrWhiteSpace(BusquedaMascotas)
        ? MascotasRegistradas
        : MascotasRegistradas.Where(m => m.Nombre.Contains(BusquedaMascotas, StringComparison.OrdinalIgnoreCase) || m.Especie.Contains(BusquedaMascotas, StringComparison.OrdinalIgnoreCase) || m.Raza.Contains(BusquedaMascotas, StringComparison.OrdinalIgnoreCase)).ToList();

    private NuevaMascotaForm NuevaMascota { get; set; } = new();
    private NuevaConsultaForm NuevaConsulta { get; set; } = new();
    private EdicionMascotaForm EdicionMascota { get; set; } = new();
    private bool ModalVisible { get; set; }
    private bool ConsultaModalVisible { get; set; }
    private bool EditarModalVisible { get; set; }
    private bool ConfirmarEliminacion { get; set; }
    private string? ToastMessage { get; set; }

    protected override void OnInitialized()
    {
        CargarDatos();
        CargandoPagina = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (MascotaSeleccionadaId is not null) return;

        var labels = new[] { "Behavior", "Hygiene", "Movement", "Mood" };
        foreach (var mascota in MascotasRegistradas)
        {
            var evaluacion = Service.ObtenerUltimaEvaluacion(mascota.Id);
            if (evaluacion is null) continue;

            var valores = new[]
            {
                evaluacion.Comportamiento,
                evaluacion.Higiene,
                evaluacion.Movimiento,
                evaluacion.Animo
            };

            await JS.InvokeVoidAsync("renderRadarChart", $"mini-chart-{mascota.Id}", labels, valores, true);
        }
    }

    private void CargarDatos()
    {
        MascotasRegistradas = Service.ListarMascotas();
        Clientes = Service.ListarClientes();
    }

    private void FiltrarMascotas() { }

    private async Task SeleccionarMascota(string mascotaId)
    {
        CargandoDetalle = true;
        MascotaSeleccionadaId = mascotaId;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(250);
        CargandoDetalle = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CerrarDetalle() => MascotaSeleccionadaId = null;

    private void AbrirModalNuevaConsulta()
    {
        if (Sesion.Rol != "Veterinario") return;

        NuevaConsulta = new NuevaConsultaForm();
        ConsultaModalVisible = true;
    }

    private void CerrarModalConsulta() => ConsultaModalVisible = false;

    private async Task GuardarConsulta()
    {
        if (Sesion.Rol != "Veterinario" || MascotaSeleccionada is null || string.IsNullOrWhiteSpace(NuevaConsulta.Motivo)) return;

        Guardando = true;
        await InvokeAsync(StateHasChanged);

        Service.AgregarConsulta(MascotaSeleccionada.Id, NuevaConsulta.Motivo.Trim(), NuevaConsulta.Notas.Trim());
        ConsultaModalVisible = false;
        Guardando = false;
        MostrarToast("Consulta registrada correctamente.");
        await InvokeAsync(StateHasChanged);
    }

    private void AbrirModalEditar()
    {
        if (Sesion.Rol != "Veterinario" || MascotaSeleccionada is null) return;

        EdicionMascota = new EdicionMascotaForm
        {
            Peso = MascotaSeleccionada.Peso,
            Sexo = MascotaSeleccionada.Sexo,
            Estado = MascotaSeleccionada.Estado,
            Notas = MascotaSeleccionada.Notas,
            FotoUrl = MascotaSeleccionada.FotoUrl
        };
        EditarModalVisible = true;
    }

    private void CerrarModalEditar() => EditarModalVisible = false;

    private async Task GuardarEdicion()
    {
        if (Sesion.Rol != "Veterinario" || MascotaSeleccionada is null) return;

        Guardando = true;
        await InvokeAsync(StateHasChanged);

        Service.ActualizarDatosMascota(MascotaSeleccionada.Id, EdicionMascota.Peso, EdicionMascota.Sexo, EdicionMascota.Estado, EdicionMascota.Notas.Trim(), EdicionMascota.FotoUrl.Trim());
        CargarDatos();
        EditarModalVisible = false;
        Guardando = false;
        MostrarToast("Datos actualizados correctamente.");
        await InvokeAsync(StateHasChanged);
    }

    private void SolicitarEliminar()
    {
        if (Sesion.Rol == "Veterinario") ConfirmarEliminacion = true;
    }

    private void CancelarEliminar() => ConfirmarEliminacion = false;

    private async Task EliminarMascotaConfirmada()
    {
        if (Sesion.Rol != "Veterinario" || MascotaSeleccionadaId is null) return;

        Guardando = true;
        await InvokeAsync(StateHasChanged);

        Service.EliminarMascota(MascotaSeleccionadaId);
        MascotaSeleccionadaId = null;
        ConfirmarEliminacion = false;
        CargarDatos();
        Guardando = false;
        MostrarToast("Mascota eliminada correctamente.");
        await InvokeAsync(StateHasChanged);
    }

    private void AbrirModalNuevaMascota()
    {
        if (Sesion.Rol != "Veterinario") return;

        NuevaMascota = new NuevaMascotaForm { ClienteId = Clientes.FirstOrDefault()?.Id ?? "" };
        ModalVisible = true;
    }

    private void CerrarModal() => ModalVisible = false;

    private async Task GuardarMascota()
    {
        if (Sesion.Rol != "Veterinario") return;

        if (string.IsNullOrWhiteSpace(NuevaMascota.Nombre) || (!NuevaMascota.UsarNuevoCliente && string.IsNullOrWhiteSpace(NuevaMascota.ClienteId)) || (NuevaMascota.UsarNuevoCliente && string.IsNullOrWhiteSpace(NuevaMascota.NombreCliente)))
        {
            MostrarToast("Completa los datos de la mascota.");
            return;
        }

        Guardando = true;
        await InvokeAsync(StateHasChanged);

        var clienteId = NuevaMascota.ClienteId;
        if (NuevaMascota.UsarNuevoCliente)
        {
            var nuevoCliente = Service.AgregarCliente(NuevaMascota.NombreCliente.Trim(), NuevaMascota.EdadCliente, NuevaMascota.TelefonoCliente.Trim(), NuevaMascota.EmailCliente.Trim(), NuevaMascota.DireccionCliente.Trim());
            clienteId = nuevoCliente.Id;
        }

        Service.AgregarMascota(NuevaMascota.Nombre.Trim(), NuevaMascota.Especie, NuevaMascota.Raza.Trim(), NuevaMascota.Edad, clienteId, "", "");
        CargarDatos();
        ModalVisible = false;
        Guardando = false;
        MostrarToast("Mascota agregada correctamente.");
        await InvokeAsync(StateHasChanged);
    }

    private string NombreDueno(Mascota mascota) => Service.BuscarClientePorId(mascota.ClienteId)?.Nombre ?? "Sin dueño";
    private string FotoPorRaza(Mascota mascota) => !string.IsNullOrWhiteSpace(mascota.FotoUrl)
        ? mascota.FotoUrl
        : $"https://loremflickr.com/400/300/{Uri.EscapeDataString(mascota.Raza)},{mascota.Especie.ToLowerInvariant()}/all?lock={mascota.Id.GetHashCode()}";
    private static string FotoFallback(Mascota mascota)
    {
        var archivo = mascota.Raza.Trim().ToLowerInvariant() switch
        {
            "pastor aleman" or "pastor alemán" => "German Shepherd Dog.jpg",
            "siames" or "siamés" => "Siamese cat.jpg",
            "bulldog frances" or "bulldog francés" => "French bulldog head, Josselin 02.jpg",
            "persa" => "Persian cat.jpg",
            "golden retriever" => "Golden Retriever.jpg",
            "chihuahua" => "Chihuahua.jpg",
            "angora" => "Turkish Angora.jpg",
            "labrador" => "Labrador Retriever.jpg",
            "mini lop" => "Mini lop.jpg",
            _ => null
        };

        return archivo is not null
            ? $"https://commons.wikimedia.org/wiki/Special:FilePath/{Uri.EscapeDataString(archivo)}?width=400"
            : $"https://picsum.photos/seed/{Uri.EscapeDataString($"{mascota.Raza}-{mascota.Especie}")}/400/300";
    }
    private string TemaEspecie(string especie) => especie.ToLowerInvariant() switch { "gato" => "activity-lilac", "conejo" => "activity-orange", _ => "activity-green" };

    private void MostrarToast(string mensaje)
    {
        ToastCts?.Cancel();
        ToastMessage = mensaje;
        ToastCts = new CancellationTokenSource();
        _ = Task.Delay(3000, ToastCts.Token).ContinueWith(_ =>
        {
            ToastMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private sealed class NuevaMascotaForm
    {
        public string Nombre { get; set; } = "";
        public string Especie { get; set; } = "Perro";
        public string Raza { get; set; } = "";
        public int Edad { get; set; }
        public string ClienteId { get; set; } = "";
        public bool UsarNuevoCliente { get; set; }
        public string NombreCliente { get; set; } = "";
        public int EdadCliente { get; set; }
